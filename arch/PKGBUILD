# Maintainer: CharOfString <root@charofstring.cc>
pkgname=deepin-gtk-theme-git
pkgver=26.0.0
pkgrel=1
pkgdesc='GTK theme for GXDE (deepin and deepin-dark)'
arch=('any')
url="https://github.com/GXDE-OS/deepin-gtk-theme"
license=('GPL-3.0-or-later')
optdepends=('gtk-engine-murrine: for the GTK2 theme')
makedepends=('git')
provides=('deepin-gtk-theme')
conflicts=('deepin-gtk-theme')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

package() {
  make -C "$(_srcroot)" DESTDIR="$pkgdir" install
}
